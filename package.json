{
  "name": "dsh-workspace-plugin",
  "version": "0.3.0",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.client.js",
    "lib/typert.client.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/types",
    "lib/style.css",
    "cordis.patch.yml",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "import": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "import": "./lib/typert.host.js",
      "default": "./lib/typert.host.js"
    },
    "./client/typert": {
      "types": "./lib/typert.client.d.ts",
      "import": "./lib/typert.client.js",
      "default": "./lib/typert.client.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "import": "./lib/typert.remote-client.js",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.1.0-rc.6",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-token-meter": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-generator": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-registry": "0.1.0-rc.6",
    "@tsdown/css": "0.22.14",
    "@types/node": "26.2.0",
    "@types/react": "18.3.12",
    "react": "18.3.1",
    "react-test-renderer": "^18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "node scripts/check.mjs",
    "smoke:compat": "node --experimental-strip-types scripts/dsh-compat-smoke.mjs"
  }
}
